{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn",
    "style": "off",
    "pedantic": "off",
    "restriction": "off",
    "nursery": "off"
  },
  "plugins": ["typescript", "vitest", "import", "unicorn", "oxc"],
  "env": {
    "node": true,
    "es2022": true
  },
  "rules": {
    "no-underscore-dangle": ["warn", { "allow": ["_tag"] }]
  },
  "ignorePatterns": [
    "dist/**",
    "**/dist/**",
    "coverage/**",
    ".changeset/**",
    "fallow-baselines/**",
    "examples/**"
  ],
  "overrides": [
    {
      "files": ["packages/*/src/__tests__/**/*.ts"],
      "env": {
        "vitest": true
      }
    }
  ]
}
