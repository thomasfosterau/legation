{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn",
    "style": "off",
    "pedantic": "off",
    "restriction": "off",
    "nursery": "off"
  },
  "plugins": ["typescript", "vitest", "import", "unicorn", "oxc"],
  "env": {
    "node": true,
    "es2022": true
  },
  "rules": {
    "no-underscore-dangle": [
      "warn",
      {
        "allow": ["_tag"]
      }
    ]
  },
  "ignorePatterns": [
    "dist/**",
    "**/dist/**",
    "coverage/**",
    ".changeset/**",
    "fallow-baselines/**",
    "examples/**"
  ],
  "overrides": [
    {
      "files": ["packages/*/src/**/__tests__/**/*.ts"],
      "env": {
        "vitest": true
      },
      "rules": {
        "vitest/no-standalone-expect": [
          "error",
          {
            "additionalTestBlockFunctions": [
              "it.effect",
              "it.live",
              "it.scoped",
              "it.scopedLive",
              "it.layer"
            ]
          }
        ],
        "vitest/expect-expect": [
          "error",
          {
            "assertFunctionNames": ["expect", "expect*", "check*"]
          }
        ],
        "vitest/valid-expect": [
          "error",
          {
            "maxArgs": 2
          }
        ],
        "vitest/no-conditional-expect": "off",
        "vitest/require-to-throw-message": "off"
      }
    },
    {
      "files": ["packages/*/src/**/__tests__/**/*.bench.ts"],
      "rules": {
        "vitest/expect-expect": [
          "error",
          {
            "assertFunctionNames": ["expect", "expect*", "check*", "bench", "bench.*"]
          }
        ]
      }
    }
  ]
}
