{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "entry": ["packages/*/src/index.ts", "packages/*/examples/*.ts"],
  "publicPackages": ["@thomasfosterau/legation-*"],
  "ignorePatterns": ["**/dist/**", "coverage/**", "examples/**", "scripts/**", "**/*.bench.ts"],
  "ignoreDependencies": [
    "@thomasfosterau/legation-effect",
    "@thomasfosterau/legation-sql",
    "publint",
    "@arethetypeswrong/cli",
    "@effect/vitest"
  ],
  "rules": {
    "duplicate-exports": "off"
  },
  "duplicates": {
    "ignore": ["packages/*/src/__tests__/**"]
  }
}
