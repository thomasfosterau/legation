{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "entry": [
    "packages/effect/src/index.ts",
    "packages/effect/src/Node.ts",
    "packages/effect/src/Edge.ts",
    "packages/effect/src/Collection.ts",
    "packages/effect/src/Query.ts",
    "packages/effect/src/Aggregate.ts",
    "packages/effect/src/Mutator.ts",
    "packages/effect/src/CrudMutation.ts",
    "packages/effect/src/Client.ts",
    "packages/effect/src/ClientStore.ts",
    "packages/effect/src/Identity.ts",
    "packages/effect/src/Transport.ts",
    "packages/effect/src/Hydration.ts",
    "packages/effect/src/Server.ts",
    "packages/effect/src/Backend.ts",
    "packages/effect/src/MemoryBackend.ts",
    "packages/effect/src/Authorization.ts",
    "packages/effect/src/FilterPolicy.ts",
    "packages/effect/src/Predicate.ts",
    "packages/effect/src/internal.ts",
    "packages/effect/src/sql/index.ts",
    "packages/browser/src/index.ts",
    "packages/browser/src/IndexedDbClientStore.ts",
    "packages/browser/src/BroadcastMirrorChannel.ts",
    "packages/browser/src/ServiceWorkerHost.ts",
    "packages/browser/src/ElectedHost.ts",
    "packages/browser/src/CacheApiHttpCache.ts",
    "packages/browser/src/HttpCacheInvalidation.ts",
    "packages/browser/src/BrowserConnectivity.ts",
    "packages/browser/src/BackgroundSync.ts",
    "packages/browser/src/PushPoke.ts",
    "packages/browser/src/http-cache.ts",
    "packages/alchemy-cloudflare/src/index.ts",
    "packages/alchemy-cloudflare/src/BindingTransport.ts",
    "packages/alchemy-cloudflare/src/D1Executor.ts",
    "packages/alchemy-cloudflare/src/DurableCvrStore.ts",
    "packages/alchemy-cloudflare/src/DurableFanoutBroker.ts",
    "packages/alchemy-cloudflare/src/EdgeInvalidation.ts",
    "packages/alchemy-cloudflare/src/FanoutShard.ts",
    "packages/alchemy-cloudflare/src/Room.ts",
    "packages/alchemy-cloudflare/src/RoomProtocol.ts",
    "packages/alchemy-cloudflare/src/RoomTransport.ts",
    "packages/alchemy-cloudflare/src/Worker.ts",
    "packages/auth/src/index.ts",
    "packages/auth/src/Principal.ts",
    "packages/auth/src/ReadScopes.ts",
    "packages/auth/src/Resolver.ts",
    "packages/auth/src/client.ts",
    "packages/devtools/src/index.ts",
    "packages/devtools/svelte/index.ts",
    "packages/jsonapi/src/index.ts",
    "packages/jsonapi/src/schema.ts",
    "packages/jsonapi/src/CollectionLoader.ts",
    "packages/jsonapi/src/Convention.ts",
    "packages/jsonapi/src/Derive.ts",
    "packages/jsonapi/src/DocumentWriter.ts",
    "packages/jsonapi/src/JsonApiBackend.ts",
    "packages/jsonapi/src/JsonApiFacade.ts",
    "packages/jsonapi/src/FacadeWrites.ts",
    "packages/jsonapi/src/JsonApiQuery.ts",
    "packages/jsonapi/src/JsonApiSync.ts",
    "packages/jsonapi/src/MutationStatus.ts",
    "packages/jsonapi/src/Ledger.ts",
    "packages/jsonapi/src/NodeBridge.ts",
    "packages/jsonapi/src/Relationships.ts",
    "packages/jsonapi/src/ReplicaDocuments.ts",
    "packages/jsonapi/src/RestHandlers.ts",
    "packages/svelte/src/index.svelte.ts",
    "packages/svelte/src/kit/index.ts",
    "packages/*/src/**/__tests__/**/*.test.ts",
    "packages/*/src/**/__tests__/**/*.bench.ts",
    "**/vite.config.ts",
    "vite.package.ts",
    "vitest.global-setup.ts",
    "packages/devtools/svelte.config.js",
    "scripts/*.mjs"
  ],
  "supportEntry": ["stacks/*.ts"],
  "publicPackages": ["@thomasfosterau/legation", "@thomasfosterau/legation-*"],
  "ignorePatterns": ["**/dist/**", "coverage/**", "examples/**", ".claude/skills/**"],
  "ignoreDependencies": [
    "@thomasfosterau/legation",
    "@arethetypeswrong/cli",
    "@changesets/cli",
    "@effect/language-service",
    "@effect/tsgo",
    "@typescript/native",
    "@vitest/coverage-v8",
    "fallow",
    "jsdom",
    "playwright-core",
    "publint",
    "typescript",
    "vite",
    "vite-plus",
    "vitest"
  ],
  "rules": {
    "duplicate-exports": "off",
    "boundary-violation": "error",
    "circular-dependencies": "error",
    "unresolved-imports": "error",
    "unlisted-dependencies": "error",
    "unused-dependencies": "error",
    "unused-files": "error"
  },
  "duplicates": {
    "ignore": ["packages/*/src/__tests__/**"]
  },
  "boundaries": {
    "zones": [
      {
        "name": "effect",
        "patterns": ["packages/effect/**"]
      },
      {
        "name": "browser",
        "patterns": ["packages/browser/**"]
      },
      {
        "name": "alchemy-cloudflare",
        "patterns": ["packages/alchemy-cloudflare/**"]
      },
      {
        "name": "auth",
        "patterns": ["packages/auth/**"]
      },
      {
        "name": "devtools",
        "patterns": ["packages/devtools/**"]
      },
      {
        "name": "jsonapi",
        "patterns": ["packages/jsonapi/**"]
      },
      {
        "name": "svelte",
        "patterns": ["packages/svelte/**"]
      }
    ],
    "rules": [
      {
        "from": "effect",
        "allow": []
      },
      {
        "from": "browser",
        "allow": ["effect"]
      },
      {
        "from": "alchemy-cloudflare",
        "allow": ["effect"]
      },
      {
        "from": "auth",
        "allow": ["effect"]
      },
      {
        "from": "devtools",
        "allow": ["effect"]
      },
      {
        "from": "jsonapi",
        "allow": ["effect"]
      },
      {
        "from": "svelte",
        "allow": ["effect"]
      }
    ]
  },
  "health": {
    "coverage": "coverage/coverage-final.json",
    "ignore": ["scripts/**"]
  }
}
