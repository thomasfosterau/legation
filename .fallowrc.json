{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "entry": ["packages/*/src/index.ts", "packages/*/examples/*.ts"],
  "publicPackages": ["@legation/*"],
  "ignorePatterns": ["**/dist/**", "coverage/**", "examples/**", "scripts/**"],
  "ignoreDependencies": ["@legation/effect"],
  "rules": {
    "duplicate-exports": "off"
  },
  "duplicates": {
    "ignore": ["packages/*/src/__tests__/**"]
  }
}
