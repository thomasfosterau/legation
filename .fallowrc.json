{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "entry": ["packages/*/src/index.ts", "packages/*/examples/*.ts"],
  "publicPackages": ["@thomasfosterau/*"],
  "ignorePatterns": ["**/dist/**", "coverage/**"],
  "ignoreDependencies": ["@thomasfosterau/effect-sync-core"],
  "rules": {
    "duplicate-exports": "off"
  },
  "duplicates": {
    "ignore": ["packages/*/src/__tests__/**"]
  }
}
