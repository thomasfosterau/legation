{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "incremental": false,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@legation/effect": ["packages/effect/src/index.ts"],
      "@legation/effect/internal": ["packages/effect/src/internal.ts"],
      "@legation/browser": ["packages/browser/src/index.ts"],
      "@legation/cloudflare": ["packages/cloudflare/src/index.ts"],
      "@legation/node": ["packages/node/src/index.ts"],
      "@legation/jsonapi": ["packages/jsonapi/src/index.ts"],
      "@legation/sql": ["packages/sql/src/index.ts"],
      "@legation/react": ["packages/react/src/index.ts"],
      "@legation/svelte": ["packages/svelte/src/index.ts"],
      "@legation/sveltekit": ["packages/sveltekit/src/index.ts"]
    },
    "lib": ["ES2023", "DOM", "DOM.Iterable"]
  },
  "include": ["packages/*/src/**/*", "packages/*/examples/**/*", "tests/**/*"],
  "exclude": ["node_modules", "packages/*/dist"]
}
