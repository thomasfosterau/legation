{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "incremental": false,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "noEmit": true,
    "paths": {
      "@thomasfosterau/legation-effect": ["./packages/effect/src/index.ts"],
      "@thomasfosterau/legation-effect/internal": ["./packages/effect/src/internal.ts"],
      "@thomasfosterau/legation-browser": ["./packages/browser/src/index.ts"],
      "@thomasfosterau/legation-cloudflare": ["./packages/cloudflare/src/index.ts"],
      "@thomasfosterau/legation-node": ["./packages/node/src/index.ts"],
      "@thomasfosterau/legation-jsonapi": ["./packages/jsonapi/src/index.ts"],
      "@thomasfosterau/legation-sql": ["./packages/sql/src/index.ts"],
      "@thomasfosterau/legation-svelte": ["./packages/svelte/src/index.svelte.ts"],
      "@thomasfosterau/legation-svelte/kit": ["./packages/svelte/src/kit/index.ts"],
      "@thomasfosterau/legation-devtools": ["./packages/devtools/src/index.ts"]
    },
    "lib": ["ES2023", "DOM", "DOM.Iterable"]
  },
  "include": ["./packages/*/src/**/*", "./packages/*/examples/**/*", "./tests/**/*"],
  "exclude": ["node_modules", "packages/*/dist"]
}
