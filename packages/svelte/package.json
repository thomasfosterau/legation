{
  "name": "@legation/svelte",
  "version": "0.1.0",
  "description": "Svelte bindings for the legation engine: rune hooks over the Client, plus the SvelteKit integration on /kit",
  "type": "module",
  "main": "./dist/index.svelte.js",
  "types": "./dist/index.svelte.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.svelte.d.ts",
      "svelte": "./dist/index.svelte.js",
      "import": "./dist/index.svelte.js"
    },
    "./kit": {
      "types": "./dist/kit/index.d.ts",
      "import": "./dist/kit/index.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "test": "vitest run --root ../.. packages/svelte"
  },
  "keywords": [
    "effect",
    "svelte",
    "sveltekit",
    "runes",
    "ssr",
    "sync-engine",
    "typescript"
  ],
  "author": "Thomas Foster",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@legation/effect": "workspace:^",
    "@thomasfosterau/effect-svelte": "^0.4.0"
  },
  "peerDependencies": {
    "effect": ">=4.0.0-rc.118",
    "svelte": ">=5.40",
    "@sveltejs/kit": "^2.70.3"
  },
  "devDependencies": {
    "effect": "catalog:",
    "svelte": "^5",
    "@sveltejs/kit": "^2.70.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thomasfosterau/legation.git",
    "directory": "packages/svelte"
  },
  "bugs": {
    "url": "https://github.com/thomasfosterau/legation/issues"
  },
  "homepage": "https://github.com/thomasfosterau/legation/tree/main/packages/svelte#readme",
  "peerDependenciesMeta": {
    "@sveltejs/kit": {
      "optional": true
    }
  }
}
