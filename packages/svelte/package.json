{
  "name": "@legation/svelte",
  "version": "0.1.0",
  "description": "Svelte bindings for the legation engine: live query stores and a mutate helper",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "test": "vitest run --root ../.. --project svelte"
  },
  "keywords": [
    "effect",
    "svelte",
    "stores",
    "runes",
    "sync-engine",
    "typescript"
  ],
  "author": "Thomas Foster",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@legation/effect": "workspace:^"
  },
  "peerDependencies": {
    "effect": "4.0.0-beta.84",
    "svelte": ">=4"
  },
  "devDependencies": {
    "effect": "catalog:",
    "svelte": "^5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thomasfosterau/legation.git",
    "directory": "packages/svelte"
  },
  "bugs": {
    "url": "https://github.com/thomasfosterau/legation/issues"
  },
  "homepage": "https://github.com/thomasfosterau/legation/tree/main/packages/svelte#readme"
}
