{
  "name": "@thomasfosterau/legation-svelte",
  "version": "0.2.0",
  "description": "Svelte bindings for the legation engine: rune hooks over the Client, plus the SvelteKit integration on /kit",
  "keywords": [
    "effect",
    "runes",
    "ssr",
    "svelte",
    "sveltekit",
    "sync-engine",
    "typescript"
  ],
  "homepage": "https://github.com/thomasfosterau/legation/tree/trunk/packages/svelte#readme",
  "bugs": {
    "url": "https://github.com/thomasfosterau/legation/issues"
  },
  "license": "MIT",
  "author": "Thomas Foster",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thomasfosterau/legation.git",
    "directory": "packages/svelte"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.svelte.js",
  "types": "./dist/index.svelte.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.svelte.d.ts",
      "svelte": "./dist/index.svelte.js",
      "import": "./dist/index.svelte.js"
    },
    "./kit": {
      "types": "./dist/kit/index.d.ts",
      "import": "./dist/kit/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@thomasfosterau/effect-svelte": "catalog:",
    "@thomasfosterau/legation-effect": "workspace:^"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@sveltejs/kit": "catalog:",
    "effect": "catalog:",
    "svelte": "catalog:"
  },
  "peerDependencies": {
    "@sveltejs/kit": "catalog:peers",
    "effect": "catalog:peers",
    "svelte": "catalog:peers"
  },
  "peerDependenciesMeta": {
    "@sveltejs/kit": {
      "optional": true
    }
  }
}
