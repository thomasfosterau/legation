{
  "name": "@thomasfosterau/legation-node",
  "version": "0.1.0",
  "description": "Node-runtime adapters for the legation engine: serving the default RPC sync transport over HTTP and WebSocket",
  "keywords": [
    "effect",
    "http",
    "node",
    "rpc",
    "server",
    "sync-engine",
    "typescript",
    "websocket"
  ],
  "homepage": "https://github.com/thomasfosterau/legation/tree/trunk/packages/node#readme",
  "bugs": {
    "url": "https://github.com/thomasfosterau/legation/issues"
  },
  "license": "MIT",
  "author": "Thomas Foster",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thomasfosterau/legation.git",
    "directory": "packages/node"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@thomasfosterau/legation-effect": "workspace:^"
  },
  "devDependencies": {
    "@effect/platform-node": "catalog:",
    "@effect/vitest": "catalog:",
    "@types/node": "catalog:",
    "effect": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@effect/platform-node": "catalog:peers",
    "effect": "catalog:peers"
  },
  "engines": {
    "node": ">=22"
  }
}
