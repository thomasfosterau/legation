{
  "name": "@legation/node",
  "version": "0.1.0",
  "description": "Node-runtime adapters for the legation engine: serving the default RPC sync transport over HTTP and WebSocket",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "test": "vitest run --root ../.."
  },
  "keywords": [
    "effect",
    "sync-engine",
    "node",
    "server",
    "rpc",
    "http",
    "websocket",
    "typescript"
  ],
  "author": "Thomas Foster",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@legation/effect": "workspace:^"
  },
  "peerDependencies": {
    "effect": ">=4.0.0-rc.113",
    "@effect/platform-node": ">=4.0.0-rc.113"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/node": "^26.6.1",
    "effect": "catalog:",
    "@effect/platform-node": "catalog:"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thomasfosterau/legation.git",
    "directory": "packages/node"
  },
  "bugs": {
    "url": "https://github.com/thomasfosterau/legation/issues"
  },
  "homepage": "https://github.com/thomasfosterau/legation/tree/main/packages/node#readme"
}
