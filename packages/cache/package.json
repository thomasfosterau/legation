{
  "name": "@thomasfosterau/effect-sync-cache",
  "version": "0.1.0",
  "description": "Write-through cache engine for service workers, edge runtimes, and servers — read-through/write-through caching with pagination support, built on Effect",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "test": "vitest run --root ../.."
  },
  "keywords": [
    "effect",
    "cache",
    "write-through",
    "service-worker",
    "edge",
    "pagination",
    "typescript"
  ],
  "author": "Thomas Foster",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@thomasfosterau/effect-sync-core": "workspace:^"
  },
  "peerDependencies": {
    "effect": "4.0.0-beta.65"
  },
  "devDependencies": {
    "effect": "4.0.0-beta.65"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thomasfosterau/effect-synchronizer.git",
    "directory": "packages/cache"
  },
  "bugs": {
    "url": "https://github.com/thomasfosterau/effect-synchronizer/issues"
  },
  "homepage": "https://github.com/thomasfosterau/effect-synchronizer/tree/main/packages/cache#readme"
}
