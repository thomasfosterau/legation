{
  "name": "@thomasfosterau/legation-browser",
  "version": "0.4.0",
  "description": "Browser-runtime adapters for the legation engine: service-worker engine host, IndexedDB client store, tab mirrors over BroadcastChannel, and a Cache API HTTP cache",
  "keywords": [
    "broadcastchannel",
    "browser",
    "effect",
    "indexeddb",
    "offline-first",
    "service-worker",
    "sync-engine",
    "typescript"
  ],
  "homepage": "https://github.com/thomasfosterau/legation/tree/trunk/packages/browser#readme",
  "bugs": {
    "url": "https://github.com/thomasfosterau/legation/issues"
  },
  "license": "MIT",
  "author": "Thomas Foster",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thomasfosterau/legation.git",
    "directory": "packages/browser"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE.md",
    "CHANGELOG.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./http-cache": {
      "types": "./dist/http-cache.d.ts",
      "import": "./dist/http-cache.js"
    },
    "./IndexedDbClientStore": {
      "types": "./dist/IndexedDbClientStore.d.ts",
      "import": "./dist/IndexedDbClientStore.js"
    },
    "./BroadcastMirrorChannel": {
      "types": "./dist/BroadcastMirrorChannel.d.ts",
      "import": "./dist/BroadcastMirrorChannel.js"
    },
    "./ServiceWorkerHost": {
      "types": "./dist/ServiceWorkerHost.d.ts",
      "import": "./dist/ServiceWorkerHost.js"
    },
    "./ElectedHost": {
      "types": "./dist/ElectedHost.d.ts",
      "import": "./dist/ElectedHost.js"
    },
    "./CacheApiHttpCache": {
      "types": "./dist/CacheApiHttpCache.d.ts",
      "import": "./dist/CacheApiHttpCache.js"
    },
    "./HttpCacheInvalidation": {
      "types": "./dist/HttpCacheInvalidation.d.ts",
      "import": "./dist/HttpCacheInvalidation.js"
    },
    "./BrowserConnectivity": {
      "types": "./dist/BrowserConnectivity.d.ts",
      "import": "./dist/BrowserConnectivity.js"
    },
    "./BackgroundSync": {
      "types": "./dist/BackgroundSync.d.ts",
      "import": "./dist/BackgroundSync.js"
    },
    "./PushPoke": {
      "types": "./dist/PushPoke.d.ts",
      "import": "./dist/PushPoke.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "docgen": "docgen"
  },
  "dependencies": {
    "@thomasfosterau/legation": "workspace:^"
  },
  "devDependencies": {
    "@effect/docgen": "catalog:",
    "@effect/platform-browser": "catalog:",
    "@effect/vitest": "catalog:",
    "effect": "catalog:",
    "fake-indexeddb": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@effect/platform-browser": "catalog:peers",
    "effect": "catalog:peers"
  }
}
