{
  "name": "@thomasfosterau/legation-browser",
  "version": "0.2.0",
  "description": "Browser-runtime adapters for the legation engine: service-worker engine host, IndexedDB client store, tab mirrors over BroadcastChannel, and a Cache API HTTP cache",
  "keywords": [
    "broadcastchannel",
    "browser",
    "effect",
    "indexeddb",
    "offline-first",
    "service-worker",
    "sync-engine",
    "typescript"
  ],
  "homepage": "https://github.com/thomasfosterau/legation/tree/trunk/packages/browser#readme",
  "bugs": {
    "url": "https://github.com/thomasfosterau/legation/issues"
  },
  "license": "MIT",
  "author": "Thomas Foster",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thomasfosterau/legation.git",
    "directory": "packages/browser"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@thomasfosterau/legation-effect": "workspace:^"
  },
  "devDependencies": {
    "@effect/platform-browser": "catalog:",
    "@effect/vitest": "catalog:",
    "effect": "catalog:",
    "fake-indexeddb": "catalog:"
  },
  "peerDependencies": {
    "@effect/platform-browser": "catalog:peers",
    "effect": "catalog:peers"
  }
}
