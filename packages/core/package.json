{
  "name": "@thomasfosterau/effect-sync-core",
  "version": "0.1.0",
  "description": "Protocol-agnostic sync and cache primitives built on Effect: keys, cache stores, write-through caching, queries, pagination, mutations, outbox, conflict resolution, and the client/server sync protocol",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "test": "vitest run --root ../.."
  },
  "keywords": [
    "effect",
    "sync-engine",
    "cache",
    "query",
    "offline-first",
    "typescript"
  ],
  "author": "Thomas Foster",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "effect": "4.0.0-beta.65"
  },
  "devDependencies": {
    "effect": "4.0.0-beta.65"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thomasfosterau/effect-synchronizer.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/thomasfosterau/effect-synchronizer/issues"
  },
  "homepage": "https://github.com/thomasfosterau/effect-synchronizer/tree/main/packages/core#readme"
}
