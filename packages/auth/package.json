{
  "name": "@thomasfosterau/legation-auth",
  "version": "0.0.0",
  "private": true,
  "description": "effect-auth for the legation sync engine: session and API-key identity, read scopes as auth filters, sign-out resets",
  "keywords": [
    "authorization",
    "effect",
    "effect-auth",
    "sync-engine",
    "typescript"
  ],
  "homepage": "https://github.com/thomasfosterau/legation/tree/trunk/packages/auth#readme",
  "bugs": {
    "url": "https://github.com/thomasfosterau/legation/issues"
  },
  "license": "MIT",
  "author": "Thomas Foster",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thomasfosterau/legation.git",
    "directory": "packages/auth"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@thomasfosterau/legation": "workspace:^"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@thomasfosterau/effect-auth": "catalog:",
    "effect": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@thomasfosterau/effect-auth": "catalog:auth-peers",
    "effect": "catalog:auth-peers"
  }
}
