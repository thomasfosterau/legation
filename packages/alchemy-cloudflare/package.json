{
  "name": "@thomasfosterau/legation-alchemy-cloudflare",
  "version": "0.4.1",
  "description": "Cloudflare deployment of the legation sync engine on Alchemy's Effect-native Cloudflare provider: per-user Durable Object rooms, topic-sharded fan-out Durable Objects, D1 backend executor",
  "keywords": [
    "alchemy",
    "cloudflare",
    "d1",
    "durable-objects",
    "effect",
    "sync-engine",
    "typescript"
  ],
  "homepage": "https://github.com/thomasfosterau/legation/tree/trunk/packages/alchemy-cloudflare#readme",
  "bugs": {
    "url": "https://github.com/thomasfosterau/legation/issues"
  },
  "license": "MIT",
  "author": "Thomas Foster",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thomasfosterau/legation.git",
    "directory": "packages/alchemy-cloudflare"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE.md",
    "CHANGELOG.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./BindingTransport": {
      "types": "./dist/BindingTransport.d.ts",
      "import": "./dist/BindingTransport.js"
    },
    "./D1Executor": {
      "types": "./dist/D1Executor.d.ts",
      "import": "./dist/D1Executor.js"
    },
    "./DurableCvrStore": {
      "types": "./dist/DurableCvrStore.d.ts",
      "import": "./dist/DurableCvrStore.js"
    },
    "./DurableFanoutBroker": {
      "types": "./dist/DurableFanoutBroker.d.ts",
      "import": "./dist/DurableFanoutBroker.js"
    },
    "./EdgeInvalidation": {
      "types": "./dist/EdgeInvalidation.d.ts",
      "import": "./dist/EdgeInvalidation.js"
    },
    "./FanoutShard": {
      "types": "./dist/FanoutShard.d.ts",
      "import": "./dist/FanoutShard.js"
    },
    "./Room": {
      "types": "./dist/Room.d.ts",
      "import": "./dist/Room.js"
    },
    "./RoomProtocol": {
      "types": "./dist/RoomProtocol.d.ts",
      "import": "./dist/RoomProtocol.js"
    },
    "./RoomTransport": {
      "types": "./dist/RoomTransport.d.ts",
      "import": "./dist/RoomTransport.js"
    },
    "./Worker": {
      "types": "./dist/Worker.d.ts",
      "import": "./dist/Worker.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "docgen": "docgen"
  },
  "dependencies": {
    "@thomasfosterau/legation": "workspace:^"
  },
  "devDependencies": {
    "@alchemy.run/cloudflare": "catalog:",
    "@cloudflare/workers-types": "catalog:",
    "@effect/docgen": "catalog:",
    "@effect/vitest": "catalog:",
    "alchemy": "catalog:",
    "effect": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@alchemy.run/cloudflare": "catalog:alchemy-peers",
    "alchemy": "catalog:alchemy-peers",
    "effect": "catalog:alchemy-peers"
  }
}
