{
  "name": "@thomasfosterau/legation-effect",
  "version": "0.1.0",
  "description": "An offline-first sync engine over a typed resource graph: Node (with its Edges), Collection, declarative Query reads, named Mutation writes, one Client per thread and one Server per backend",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./internal": {
      "types": "./dist/internal.d.ts",
      "import": "./dist/internal.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "test": "vitest run --root ../.."
  },
  "keywords": [
    "effect",
    "sync-engine",
    "cache",
    "write-through",
    "query",
    "mutation",
    "subscription",
    "offline-first",
    "service-worker",
    "edge",
    "fan-out",
    "typescript"
  ],
  "author": "Thomas Foster",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "effect": ">=4.0.0-rc.118"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "effect": "catalog:"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thomasfosterau/legation.git",
    "directory": "packages/effect"
  },
  "bugs": {
    "url": "https://github.com/thomasfosterau/legation/issues"
  },
  "homepage": "https://github.com/thomasfosterau/legation/tree/trunk/packages/effect#readme"
}
