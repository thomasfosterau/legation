{
  "name": "@thomasfosterau/legation-jsonapi",
  "version": "0.7.0",
  "description": "JSON:API v1.1 collection loaders for the legation engine: map JSON:API documents into engine collection rows",
  "keywords": [
    "collection-loader",
    "effect",
    "json-api",
    "jsonapi",
    "sync-engine",
    "typescript"
  ],
  "homepage": "https://github.com/thomasfosterau/legation/tree/trunk/packages/jsonapi#readme",
  "bugs": {
    "url": "https://github.com/thomasfosterau/legation/issues"
  },
  "license": "MIT",
  "author": "Thomas Foster",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thomasfosterau/legation.git",
    "directory": "packages/jsonapi"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE.md",
    "CHANGELOG.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./JsonApiSchema": {
      "types": "./dist/schema.d.ts",
      "import": "./dist/schema.js"
    },
    "./CollectionLoader": {
      "types": "./dist/CollectionLoader.d.ts",
      "import": "./dist/CollectionLoader.js"
    },
    "./Convention": {
      "types": "./dist/Convention.d.ts",
      "import": "./dist/Convention.js"
    },
    "./Derive": {
      "types": "./dist/Derive.d.ts",
      "import": "./dist/Derive.js"
    },
    "./DocumentWriter": {
      "types": "./dist/DocumentWriter.d.ts",
      "import": "./dist/DocumentWriter.js"
    },
    "./JsonApiBackend": {
      "types": "./dist/JsonApiBackend.d.ts",
      "import": "./dist/JsonApiBackend.js"
    },
    "./JsonApiFacade": {
      "types": "./dist/JsonApiFacade.d.ts",
      "import": "./dist/JsonApiFacade.js"
    },
    "./FacadeWrites": {
      "types": "./dist/FacadeWrites.d.ts",
      "import": "./dist/FacadeWrites.js"
    },
    "./JsonApiQuery": {
      "types": "./dist/JsonApiQuery.d.ts",
      "import": "./dist/JsonApiQuery.js"
    },
    "./JsonApiSync": {
      "types": "./dist/JsonApiSync.d.ts",
      "import": "./dist/JsonApiSync.js"
    },
    "./MutationStatus": {
      "types": "./dist/MutationStatus.d.ts",
      "import": "./dist/MutationStatus.js"
    },
    "./Ledger": {
      "types": "./dist/Ledger.d.ts",
      "import": "./dist/Ledger.js"
    },
    "./NodeBridge": {
      "types": "./dist/NodeBridge.d.ts",
      "import": "./dist/NodeBridge.js"
    },
    "./Relationships": {
      "types": "./dist/Relationships.d.ts",
      "import": "./dist/Relationships.js"
    },
    "./ReplicaDocuments": {
      "types": "./dist/ReplicaDocuments.d.ts",
      "import": "./dist/ReplicaDocuments.js"
    },
    "./RestHandlers": {
      "types": "./dist/RestHandlers.d.ts",
      "import": "./dist/RestHandlers.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "docgen": "docgen"
  },
  "dependencies": {
    "@thomasfosterau/legation": "workspace:^"
  },
  "devDependencies": {
    "@effect/docgen": "catalog:",
    "@effect/vitest": "catalog:",
    "@thomasfosterau/effect-jsonapi": "catalog:",
    "effect": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@thomasfosterau/effect-jsonapi": "catalog:jsonapi-peers",
    "effect": "catalog:jsonapi-peers"
  }
}
