{
  "name": "@thomasfosterau/legation-jsonapi",
  "version": "0.2.0",
  "description": "JSON:API v1.1 collection loaders for the legation engine: map JSON:API documents into engine collection rows",
  "keywords": [
    "collection-loader",
    "effect",
    "json-api",
    "jsonapi",
    "sync-engine",
    "typescript"
  ],
  "homepage": "https://github.com/thomasfosterau/legation/tree/trunk/packages/jsonapi#readme",
  "bugs": {
    "url": "https://github.com/thomasfosterau/legation/issues"
  },
  "license": "MIT",
  "author": "Thomas Foster",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thomasfosterau/legation.git",
    "directory": "packages/jsonapi"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
