{
  "name": "@thomasfosterau/effect-sync-sql",
  "version": "0.1.0",
  "description": "Driver-agnostic SQL reference backend for the effect-sync engine: Subset->WHERE translation and a Backend over a SqlExecutor seam",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "test": "vitest run --root ../.."
  },
  "keywords": [
    "effect",
    "sql",
    "sqlite",
    "postgres",
    "sync-engine",
    "backend",
    "typescript"
  ],
  "author": "Thomas Foster",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@thomasfosterau/effect-sync-core": "workspace:^"
  },
  "peerDependencies": {
    "effect": "4.0.0-beta.75"
  },
  "devDependencies": {
    "effect": "4.0.0-beta.75"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thomasfosterau/effect-synchronizer.git",
    "directory": "packages/sql"
  },
  "bugs": {
    "url": "https://github.com/thomasfosterau/effect-synchronizer/issues"
  },
  "homepage": "https://github.com/thomasfosterau/effect-synchronizer/tree/main/packages/sql#readme"
}
