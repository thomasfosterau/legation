{
  "name": "@thomasfosterau/legation-cloudflare",
  "version": "0.2.0",
  "description": "Cloudflare Workers reference topology for the legation sync engine: per-user Durable Object rooms, topic-sharded fan-out Durable Objects, D1 backend executor",
  "keywords": [
    "cloudflare",
    "d1",
    "durable-objects",
    "effect",
    "sync-engine",
    "typescript"
  ],
  "homepage": "https://github.com/thomasfosterau/legation/tree/trunk/packages/cloudflare#readme",
  "bugs": {
    "url": "https://github.com/thomasfosterau/legation/issues"
  },
  "license": "MIT",
  "author": "Thomas Foster",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thomasfosterau/legation.git",
    "directory": "packages/cloudflare"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@thomasfosterau/legation-effect": "workspace:^",
    "@thomasfosterau/legation-sql": "workspace:^"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@effect/vitest": "catalog:",
    "effect": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "effect": "catalog:peers"
  }
}
