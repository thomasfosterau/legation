{
  "name": "@thomasfosterau/legation-devtools",
  "version": "0.1.0",
  "description": "A devtools headless core over the introspection substrate (#120): journal/mutation timeline, subscriptions & collections, sync activity, and actions — with a Svelte panel on /svelte",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./svelte": {
      "svelte": "./svelte/index.ts",
      "types": "./svelte/index.ts",
      "default": "./svelte/index.ts"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "svelte",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "test": "vitest run --root ../.."
  },
  "keywords": [
    "effect",
    "devtools",
    "react",
    "svelte",
    "sync-engine",
    "introspection",
    "typescript"
  ],
  "author": "Thomas Foster",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@thomasfosterau/legation-effect": "workspace:^"
  },
  "peerDependencies": {
    "effect": ">=4.0.0-rc.118",
    "svelte": ">=5.40"
  },
  "peerDependenciesMeta": {
    "svelte": {
      "optional": true
    }
  },
  "devDependencies": {
    "effect": "catalog:",
    "svelte": "^5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thomasfosterau/legation.git",
    "directory": "packages/devtools"
  },
  "bugs": {
    "url": "https://github.com/thomasfosterau/legation/issues"
  },
  "homepage": "https://github.com/thomasfosterau/legation/tree/trunk/packages/devtools#readme"
}
