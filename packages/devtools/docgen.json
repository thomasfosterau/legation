{
  "$schema": "../../node_modules/@effect/docgen/schema.json",
  "srcLink": "https://github.com/thomasfosterau/legation/blob/trunk/packages/devtools/src/",
  "outDir": "docs/api",
  "enforceVersion": false,
  "runExamples": false,
  "exclude": ["src/**/*.test.ts", "src/**/*.test-d.ts", "src/internal/**"],
  "parseCompilerOptions": {
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "es2022",
    "lib": ["es2022", "dom", "dom.iterable"],
    "allowImportingTsExtensions": true
  },
  "tscExecutable": "true"
}
