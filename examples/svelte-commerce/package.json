{
  "name": "legation-svelte-commerce",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "SvelteKit commerce catalog driving the legation engine end to end: SSR + hydration with CVR continuation, public/private auth split over IdentityResolver, live relational joins, cursor pagination, offline-first writes over WebSockets with HTTP fallback, and a no-JS baseline.",
  "scripts": {
    "dev": "vite dev",
    "dev:server": "tsx server/main.ts",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run --root ../.. --project node examples/svelte-commerce",
    "prepare": "svelte-kit sync"
  },
  "dependencies": {
    "@effect/platform-node": "catalog:",
    "@legation/browser": "workspace:*",
    "@legation/effect": "workspace:*",
    "@legation/node": "workspace:*",
    "@legation/sql": "workspace:*",
    "@legation/svelte": "workspace:*",
    "@legation/sveltekit": "workspace:*",
    "effect": "catalog:",
    "svelte": "^5"
  },
  "devDependencies": {
    "@sveltejs/adapter-node": "^5.0.0",
    "@sveltejs/kit": "^2.0.0",
    "@sveltejs/vite-plugin-svelte": "^4.0.0",
    "@types/node": "^22",
    "svelte-check": "^4.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3",
    "vite": "^5.4.0"
  }
}
