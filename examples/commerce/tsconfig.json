{
  "extends": "$app/tsconfig",
  "compilerOptions": {
    "strict": true,
    "moduleResolution": "bundler",
    "module": "ESNext",
    "target": "ES2023",
    "types": ["node", "$app/types"],
    "skipLibCheck": true
  },
  "exclude": ["vite.config.ts", "node_modules/**", ".svelte-kit/[!a]*/**", "src/service-worker.ts", "build"]
}
