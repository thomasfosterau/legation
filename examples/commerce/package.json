{
  "name": "legation-commerce",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "SvelteKit commerce catalog driving the legation engine end to end: SSR + hydration with CVR continuation, public/private auth split over IdentityResolver, live relational joins, cursor pagination, offline-first writes over WebSockets with HTTP fallback, and a no-JS baseline.",
  "scripts": {
    "dev": "vite dev",
    "dev:server": "tsx server/main.ts",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json && tsc -p tsconfig.server.json",
    "test": "vitest run --root ../.. --project node examples/commerce",
    "prepare": "svelte-kit sync"
  },
  "dependencies": {
    "@effect/platform-node": "catalog:",
    "@effect/sql-sqlite-node": "catalog:",
    "@legation/browser": "workspace:*",
    "@legation/effect": "workspace:*",
    "@legation/jsonapi": "workspace:*",
    "@legation/node": "workspace:*",
    "@legation/sql": "workspace:*",
    "@legation/svelte": "workspace:*",
    "@thomasfosterau/effect-jsonapi": "^0.16.1",
    "better-auth": "^1.7.6",
    "better-sqlite3": "^13",
    "effect": "catalog:",
    "svelte": "^5"
  },
  "devDependencies": {
    "@sveltejs/adapter-node": "^5.0.0",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26",
    "svelte-check": "^4.7.6",
    "tsx": "^4.23.15",
    "typescript": "catalog:",
    "vite": "^8.3.1"
  }
}
