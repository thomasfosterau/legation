{
  "name": "legation-commerce",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "description": "SvelteKit commerce catalog driving the legation engine end to end: SSR + hydration with CVR continuation, public/private auth split over IdentityResolver, live relational joins, cursor pagination, offline-first writes over WebSockets with HTTP fallback, and a no-JS baseline.",
  "scripts": {
    "dev": "vp dev",
    "dev:server": "tsx server/main.ts",
    "build": "vp build",
    "preview": "vp preview",
    "check": "svelte-check --tsconfig ./tsconfig.json && tsc -p tsconfig.server.json",
    "test": "vp test run --root ../.. --project node --project commerce-browser examples/commerce",
    "prepare": "svelte-kit sync"
  },
  "dependencies": {
    "@effect/platform-node": "catalog:",
    "@effect/sql-sqlite-node": "catalog:",
    "@thomasfosterau/legation-browser": "workspace:*",
    "@thomasfosterau/legation-effect": "workspace:*",
    "@thomasfosterau/legation-jsonapi": "workspace:*",
    "@thomasfosterau/legation-node": "workspace:*",
    "@thomasfosterau/legation-sql": "workspace:*",
    "@thomasfosterau/legation-svelte": "workspace:*",
    "@thomasfosterau/effect-jsonapi": "catalog:",
    "better-auth": "catalog:",
    "better-sqlite3": "catalog:",
    "effect": "catalog:",
    "svelte": "catalog:"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@sveltejs/adapter-node": "catalog:",
    "@sveltejs/kit": "catalog:",
    "@sveltejs/vite-plugin-svelte": "catalog:",
    "@types/better-sqlite3": "catalog:",
    "@types/node": "catalog:",
    "svelte-check": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
