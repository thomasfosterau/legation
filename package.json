{
  "name": "@thomasfosterau/effect-chancery",
  "version": "0.1.0",
  "description": "An Effect-based library for arbitrary synchronization of data following JSON:API principles",
  "type": "module",
  "main": "./dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "packageManager": "bun@1.3.3",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest",
    "test:run": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md,yml,yaml}\"",
    "analyze": "fallow",
    "analyze:health": "fallow health",
    "analyze:dead-code": "fallow dead-code",
    "analyze:dupes": "fallow dupes",
    "analyze:audit": "fallow audit --ci",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "bun run build && changeset publish",
    "release:dry-run": "bun run build && bun pm pack --dry-run",
    "prepare": "effect-language-service patch",
    "prepublishOnly": "bun run build"
  },
  "keywords": [
    "effect",
    "synchronization",
    "json-api",
    "sync-engine",
    "typescript"
  ],
  "author": "Thomas Foster",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "effect": "4.0.0-beta.65"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@effect/language-service": "^0.85.1",
    "@vitest/coverage-v8": "^4.1.5",
    "@types/node": "^20.0.0",
    "fallow": "^2.69.0",
    "oxlint": "^1.63.0",
    "prettier": "^3.0.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thomasfosterau/effect-synchronizer.git"
  },
  "bugs": {
    "url": "https://github.com/thomasfosterau/effect-synchronizer/issues"
  },
  "homepage": "https://github.com/thomasfosterau/effect-synchronizer#readme"
}