{
  "name": "@thomasfosterau/effect-chancery",
  "version": "0.1.0",
  "description": "An Effect-based library for arbitrary synchronization of data following JSON:API principles",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "prepare": "effect-language-service patch",
    "prepublishOnly": "bun run build"
  },
  "keywords": [
    "effect",
    "synchronization",
    "json-api",
    "sync-engine",
    "typescript"
  ],
  "author": "Thomas Foster",
  "license": "MIT",
  "dependencies": {
    "@effect/platform": "^0.96.1",
    "effect": "^3.21.2"
  },
  "devDependencies": {
    "@effect/language-service": "^0.85.1",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.0.0",
    "vitest": "^2.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thomasfosterau/effect-chancery.git"
  },
  "bugs": {
    "url": "https://github.com/thomasfosterau/effect-chancery/issues"
  },
  "homepage": "https://github.com/thomasfosterau/effect-chancery#readme"
}