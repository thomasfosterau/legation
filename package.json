{
  "$schema": "https://www.schemastore.org/package",
  "name": "legation-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Effect-based sync engine monorepo: core primitives, client query manager, write-through cache, and server fan-out",
  "homepage": "https://github.com/thomasfosterau/legation#readme",
  "bugs": {
    "url": "https://github.com/thomasfosterau/legation/issues"
  },
  "license": "MIT",
  "author": "Thomas Foster <me@thomasfoster.au>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thomasfosterau/legation.git"
  },
  "type": "module",
  "scripts": {
    "changeset": "changeset",
    "version": "changeset version && vp fmt && pnpm install --lockfile-only",
    "release": "vp run build && node scripts/publish.mjs",
    "release:dry-run": "vp run build && node scripts/publish.mjs --dry-run",
    "prepare": "vp config && effect-tsgo patch --typescript --oxlint"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "catalog:",
    "@changesets/cli": "catalog:",
    "@effect/language-service": "catalog:",
    "@effect/tsgo": "catalog:",
    "@electric-sql/pglite": "catalog:",
    "@mpsuesser/oxlint-plugin-effect": "catalog:",
    "@sveltejs/vite-plugin-svelte": "catalog:",
    "@types/node": "catalog:",
    "@typescript/native": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "effect": "catalog:",
    "fallow": "catalog:",
    "jsdom": "catalog:",
    "playwright-core": "catalog:",
    "publint": "catalog:",
    "svelte": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=22",
    "pnpm": ">=11"
  },
  "packageManager": "pnpm@11.28.6"
}
