{
  "name": "effect-sync-monorepo",
  "private": true,
  "description": "Effect-based sync engine monorepo: core primitives, client query manager, write-through cache, and server fan-out",
  "type": "module",
  "packageManager": "bun@1.3.3",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc --build tsconfig.json",
    "build:clean": "tsc --build tsconfig.json --clean",
    "typecheck": "tsc -p tsconfig.check.json",
    "test": "vitest",
    "test:run": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md,yml,yaml}\"",
    "analyze": "fallow",
    "analyze:health": "fallow health",
    "analyze:dead-code": "fallow dead-code",
    "analyze:dupes": "fallow dupes",
    "analyze:audit": "fallow audit --ci",
    "analyze:audit:ci": "fallow audit --ci --coverage coverage/coverage-final.json --base origin/main",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "bun run build && changeset publish",
    "prepare": "effect-language-service patch"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@effect/language-service": "^0.85.1",
    "@types/node": "^20.0.0",
    "@vitest/coverage-v8": "^4.1.5",
    "effect": "4.0.0-beta.65",
    "fallow": "^2.69.0",
    "oxlint": "^1.63.0",
    "prettier": "^3.0.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thomasfosterau/effect-synchronizer.git"
  },
  "bugs": {
    "url": "https://github.com/thomasfosterau/effect-synchronizer/issues"
  },
  "homepage": "https://github.com/thomasfosterau/effect-synchronizer#readme",
  "author": "Thomas Foster",
  "license": "MIT"
}
