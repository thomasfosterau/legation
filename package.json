{
  "name": "legation-monorepo",
  "private": true,
  "description": "Effect-based sync engine monorepo: core primitives, client query manager, write-through cache, and server fan-out",
  "type": "module",
  "packageManager": "bun@1.3.3",
  "workspaces": {
    "packages": [
      "packages/*",
      "examples/*"
    ],
    "catalog": {
      "effect": "4.0.0-rc.118",
      "@effect/platform-browser": "4.0.0-rc.118",
      "@effect/platform-node": "4.0.0-rc.118",
      "@effect/vitest": "4.0.0-rc.118",
      "@effect/sql-sqlite-node": "4.0.0-rc.118"
    }
  },
  "overrides": {
    "@effect/platform-node-shared": "4.0.0-rc.118"
  },
  "scripts": {
    "build": "tsc --build tsconfig.json",
    "build:clean": "tsc --build tsconfig.json --clean",
    "typecheck": "tsc -p tsconfig.check.json",
    "typecheck:examples": "bun run scripts/typecheck-examples.ts",
    "test": "vitest",
    "test:run": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "bench": "vitest bench --run --reporter=verbose",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md,yml,yaml}\"",
    "analyze": "fallow",
    "analyze:health": "fallow health",
    "analyze:dead-code": "fallow dead-code",
    "analyze:dupes": "fallow dupes",
    "analyze:audit": "fallow audit --ci --base origin/trunk",
    "analyze:audit:ci": "fallow audit --ci --coverage coverage/coverage-final.json --base origin/trunk",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "bun run build && changeset publish",
    "prepare": "effect-language-service patch"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@effect/language-service": "^0.87.3",
    "@effect/sql-sqlite-node": "catalog:",
    "@effect/vitest": "catalog:",
    "@electric-sql/pglite": "^0.5.8",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^26.6.3",
    "@vitest/coverage-v8": "^5.0.2",
    "effect": "catalog:",
    "fallow": "^3.30.0",
    "jsdom": "^30.1.1",
    "oxlint": "^1.85.0",
    "playwright-core": "1.63.0",
    "prettier": "^3.9.9",
    "svelte": "^5",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thomasfosterau/legation.git"
  },
  "bugs": {
    "url": "https://github.com/thomasfosterau/legation/issues"
  },
  "homepage": "https://github.com/thomasfosterau/legation#readme",
  "author": "Thomas Foster",
  "license": "MIT"
}
