{
  "name": "legation-monorepo",
  "private": true,
  "description": "Effect-based sync engine monorepo: core primitives, client query manager, write-through cache, and server fan-out",
  "type": "module",
  "packageManager": "bun@1.3.3",
  "workspaces": {
    "packages": [
      "packages/*",
      "examples/foldkit-todo",
      "examples/react-todo",
      "examples/svelte-todo",
      "examples/react-realworld",
      "examples/svelte-realworld",
      "examples/react-northwind",
      "examples/svelte-northwind",
      "examples/svelte-commerce"
    ],
    "catalog": {
      "effect": "4.0.0-beta.84",
      "@effect/platform-browser": "4.0.0-beta.84",
      "@effect/platform-node": "4.0.0-beta.84",
      "@effect/vitest": "4.0.0-beta.84"
    }
  },
  "scripts": {
    "build": "tsc --build tsconfig.json",
    "build:clean": "tsc --build tsconfig.json --clean",
    "typecheck": "tsc -p tsconfig.check.json",
    "typecheck:examples": "bun run scripts/typecheck-examples.ts",
    "test": "vitest",
    "test:run": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "bench": "vitest bench --run",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md,yml,yaml}\"",
    "analyze": "fallow",
    "analyze:health": "fallow health",
    "analyze:dead-code": "fallow dead-code",
    "analyze:dupes": "fallow dupes",
    "analyze:audit": "fallow audit --ci",
    "analyze:audit:ci": "fallow audit --ci --coverage coverage/coverage-final.json --base origin/main",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "bun run build && changeset publish",
    "prepare": "effect-language-service patch"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@effect/language-service": "^0.85.1",
    "@effect/vitest": "catalog:",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@testing-library/react": "16",
    "@types/node": "^20.0.0",
    "@types/react": "18",
    "@types/react-dom": "18",
    "@vitest/coverage-v8": "^4.1.5",
    "effect": "catalog:",
    "fallow": "^2.69.0",
    "jsdom": "^29.1.1",
    "oxlint": "^1.63.0",
    "prettier": "^3.0.0",
    "react": "18",
    "react-dom": "18",
    "svelte": "^5",
    "typescript": "^5.9.3",
    "vite": "^8.0.0",
    "vitest": "^4.1.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thomasfosterau/legation.git"
  },
  "bugs": {
    "url": "https://github.com/thomasfosterau/legation/issues"
  },
  "homepage": "https://github.com/thomasfosterau/legation#readme",
  "author": "Thomas Foster",
  "license": "MIT"
}
